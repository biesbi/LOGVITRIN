generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  PENDING
  SUSPENDED
  ENDED
}

enum LeasePriceType {
  DAILY
  MONTHLY
  FIXED_LOCATION
  VOLUME_BASED
  AREA_BASED
  PALLET_BASED
}

enum LeaseStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  BLOCKED
  EXPIRED
  CANCELLED
}

enum LocationType {
  WAREHOUSE_AREA
  ZONE
  RACK
  BIN
  RECEIVING
  QC
  PICK_FACE
}

enum LocationStatus {
  AVAILABLE
  RESERVED
  LEASED
  BLOCKED
  RECEIVING
  PICK_FACE
  QC
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum OrderStatus {
  DRAFT
  CREATED
  RESERVED
  RELEASED_TO_PICK
  PICKING
  PICKED
  PACKING
  PACKED
  LABELED
  DISPATCHED
  COMPLETED
  CANCELLED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  PARTIAL
  RELEASED
  CONSUMED
  CANCELLED
}

enum TaskType {
  INBOUND_COUNTING
  PUTAWAY
  PICKING
  PACKING
  SHIPPING
  STOCK_COUNT
  DAMAGE_CHECK
  TRANSFER
}

enum TaskStatus {
  CREATED
  ASSIGNED
  STARTED
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum ShipmentStatus {
  CREATED
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum TaskEventType {
  CREATED
  ASSIGNED
  STARTED
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  LOCATION_SCANNED
  PRODUCT_SCANNED
  QUANTITY_ENTERED
}

enum DocumentType {
  CONTRACT
  IDENTITY
  INVOICE
  WAYBILL
  IMAGE
  OTHER
}

enum AuditActorType {
  USER
  SYSTEM
  API_KEY
}

model Company {
  id                String             @id @default(cuid())
  name              String
  taxNumber         String?            @unique
  status            CompanyStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  users             Membership[]
  products          Product[]
  productBarcodes   ProductBarcode[]
  orders            Order[]
  reservations      Reservation[]
  tasks             Task[]
  payments          Payment[]
  invoices          Invoice[]
  leases            LeaseContract[]
  inventoryLedgers  InventoryLedger[]
  inventoryBalances InventoryBalance[]
  shipments         Shipment[]
  files             File[]
  customerDocuments CustomerDocument[]
  auditLogs         AuditLog[]

  @@index([deletedAt])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  firstName       String
  lastName        String
  phone           String?
  passwordHash    String
  status          UserStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  memberships     Membership[]
  assignedTasks   Task[]            @relation("AssignedTasks")
  createdTasks    Task[]            @relation("CreatedTasks")
  taskEvents      TaskEvent[]
  orderCreatedBy  Order[]           @relation("OrderCreatedBy")
  reservationBy   Reservation[]     @relation("ReservationCreatedBy")
  ledgerCreatedBy InventoryLedger[]
  auditLogs       AuditLog[]

  @@index([deletedAt])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  scopes      String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  memberships Membership[]

  @@index([deletedAt])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id])
  company   Company          @relation(fields: [companyId], references: [id])
  role      Role             @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId, roleId])
  @@index([companyId, status])
  @@index([deletedAt])
}

model Warehouse {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  addressLine       String?
  city              String?
  country           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  locations         Location[]
  leases            LeaseContract[]
  orders            Order[]
  tasks             Task[]
  shipments         Shipment[]
  inventoryLedgers  InventoryLedger[]
  inventoryBalances InventoryBalance[]

  @@index([deletedAt])
}

model Location {
  id                String             @id @default(cuid())
  warehouseId       String
  code              String
  status            LocationStatus     @default(AVAILABLE)
  type              LocationType?
  parentId          String?
  widthCm           Decimal?           @db.Decimal(10, 2)
  heightCm          Decimal?           @db.Decimal(10, 2)
  depthCm           Decimal?           @db.Decimal(10, 2)
  volumeCm3         Decimal?           @db.Decimal(14, 2)
  maxWeightKg       Decimal?           @db.Decimal(10, 3)
  capacity          Decimal?           @db.Decimal(12, 3)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  parent            Location?          @relation("LocationTree", fields: [parentId], references: [id])
  children          Location[]         @relation("LocationTree")
  leases            LeaseContract[]
  inventoryLedgers  InventoryLedger[]
  inventoryBalances InventoryBalance[]
  reservations      Reservation[]
  taskEvents        TaskEvent[]

  @@unique([warehouseId, code])
  @@index([status])
  @@index([deletedAt])
}

model LeaseContract {
  id          String          @id @default(cuid())
  companyId   String
  warehouseId String
  locationId  String?
  startsAt    DateTime
  endsAt      DateTime?
  status      LeaseStatus     @default(DRAFT)
  priceType   LeasePriceType?
  currency    String          @default("TRY")
  capacitySqm Decimal?        @db.Decimal(12, 2)
  volumeM3    Decimal?        @db.Decimal(12, 3)
  amount      Decimal?        @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  company     Company         @relation(fields: [companyId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  location    Location?       @relation(fields: [locationId], references: [id])

  @@index([companyId, status])
  @@index([warehouseId])
  @@index([deletedAt])
}

model Product {
  id                String             @id @default(cuid())
  companyId         String
  sku               String
  name              String
  description       String?
  unit              String?
  widthCm           Decimal?           @db.Decimal(10, 2)
  heightCm          Decimal?           @db.Decimal(10, 2)
  depthCm           Decimal?           @db.Decimal(10, 2)
  weightGram        Decimal?           @db.Decimal(12, 3)
  volumeCm3         Decimal?           @db.Decimal(14, 2)
  desi              Decimal?           @db.Decimal(10, 3)
  declaredValue     Decimal?           @db.Decimal(14, 2)
  status            ProductStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  company           Company            @relation(fields: [companyId], references: [id])
  barcodes          ProductBarcode[]
  orderItems        OrderItem[]
  reservationItems  Reservation[]
  inventoryLedgers  InventoryLedger[]
  inventoryBalances InventoryBalance[]

  @@unique([companyId, sku])
  @@index([deletedAt])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  companyId String
  productId String
  barcode   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  product   Product  @relation(fields: [productId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, barcode])
  @@index([deletedAt])
}

model InventoryLedger {
  id                  String                @id @default(cuid())
  companyId           String
  warehouseId         String
  locationId          String?
  productId           String
  movementType        InventoryMovementType
  quantity            Decimal               @db.Decimal(14, 3)
  unitCost            Decimal?              @db.Decimal(14, 4)
  orderId             String?
  reservationId       String?
  taskId              String?
  referenceDocumentNo String?
  note                String?
  createdByUserId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  company             Company               @relation(fields: [companyId], references: [id])
  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id])
  location            Location?             @relation(fields: [locationId], references: [id])
  product             Product               @relation(fields: [productId], references: [id])
  order               Order?                @relation(fields: [orderId], references: [id])
  reservation         Reservation?          @relation(fields: [reservationId], references: [id])
  task                Task?                 @relation(fields: [taskId], references: [id])
  createdByUser       User?                 @relation(fields: [createdByUserId], references: [id])

  @@index([companyId, productId, warehouseId, locationId])
  @@index([movementType, createdAt])
  @@index([deletedAt])
}

model InventoryBalance {
  id               String    @id @default(cuid())
  companyId        String
  warehouseId      String
  locationId       String
  productId        String
  onHandQty        Decimal   @default(0) @db.Decimal(14, 3)
  reservedQty      Decimal   @default(0) @db.Decimal(14, 3)
  availableQty     Decimal   @default(0) @db.Decimal(14, 3)
  lastLedgerEntryId String?
  lastCalculatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  company          Company   @relation(fields: [companyId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  location         Location  @relation(fields: [locationId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])

  @@unique([companyId, warehouseId, locationId, productId])
  @@index([deletedAt])
}

model Order {
  id               String            @id @default(cuid())
  companyId        String
  warehouseId      String
  orderNo          String
  status           OrderStatus       @default(CREATED)
  customerName     String?
  customerPhone    String?
  customerAddress  String?
  notes            String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  createdByUser    User?             @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  items            OrderItem[]
  reservations     Reservation[]
  tasks            Task[]
  shipments        Shipment[]
  inventoryLedgers InventoryLedger[]

  @@unique([companyId, orderNo])
  @@index([status, warehouseId])
  @@index([deletedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal  @db.Decimal(14, 3)
  unitPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([deletedAt])
}

model Reservation {
  id               String            @id @default(cuid())
  companyId        String
  orderId          String
  productId        String
  locationId       String?
  quantity         Decimal           @db.Decimal(14, 3)
  status           ReservationStatus @default(ACTIVE)
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  location         Location?         @relation(fields: [locationId], references: [id])
  createdByUser    User?             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  inventoryLedgers InventoryLedger[]

  @@index([companyId, status])
  @@index([deletedAt])
}

model Task {
  id               String            @id @default(cuid())
  companyId        String
  warehouseId      String
  orderId          String?
  type             TaskType
  status           TaskStatus        @default(CREATED)
  priority         Int               @default(0)
  assignedToUserId String?
  createdByUserId  String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  assignedToUser   User?             @relation("AssignedTasks", fields: [assignedToUserId], references: [id])
  createdByUser    User?             @relation("CreatedTasks", fields: [createdByUserId], references: [id])
  events           TaskEvent[]
  inventoryLedgers InventoryLedger[]

  @@index([companyId, status, warehouseId])
  @@index([assignedToUserId])
  @@index([deletedAt])
}

model TaskEvent {
  id          String        @id @default(cuid())
  taskId      String
  actorUserId String?
  locationId  String?
  eventType   TaskEventType
  eventName   String
  eventData   Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  task        Task          @relation(fields: [taskId], references: [id])
  actorUser   User?         @relation(fields: [actorUserId], references: [id])
  location    Location?     @relation(fields: [locationId], references: [id])

  @@index([taskId, createdAt])
  @@index([deletedAt])
}

model Shipment {
  id                String         @id @default(cuid())
  companyId         String
  warehouseId       String
  orderId           String
  trackingNumber    String?
  packageWidthCm    Decimal?       @db.Decimal(10, 2)
  packageHeightCm   Decimal?       @db.Decimal(10, 2)
  packageDepthCm    Decimal?       @db.Decimal(10, 2)
  packageWeightGram Decimal?       @db.Decimal(12, 3)
  desi              Decimal?       @db.Decimal(10, 3)
  carrier           String?
  status            ShipmentStatus @default(CREATED)
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id])
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id])

  @@index([companyId, status])
  @@index([deletedAt])
}

model Payment {
  id          String        @id @default(cuid())
  companyId   String
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("TRY")
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  externalRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  company     Company       @relation(fields: [companyId], references: [id])
  invoices    Invoice[]

  @@index([companyId, status])
  @@index([deletedAt])
}

model Invoice {
  id        String        @id @default(cuid())
  companyId String
  paymentId String?
  invoiceNo String
  amount    Decimal       @db.Decimal(14, 2)
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime?
  dueAt     DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  company   Company       @relation(fields: [companyId], references: [id])
  payment   Payment?      @relation(fields: [paymentId], references: [id])

  @@unique([companyId, invoiceNo])
  @@index([deletedAt])
}

model File {
  id                String             @id @default(cuid())
  companyId         String
  path              String
  fileName          String
  mimeType          String?
  size              Int?
  documentType      DocumentType       @default(OTHER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  company           Company            @relation(fields: [companyId], references: [id])
  customerDocuments CustomerDocument[]

  @@index([companyId])
  @@index([deletedAt])
}

model CustomerDocument {
  id        String   @id @default(cuid())
  companyId String
  fileId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  company   Company  @relation(fields: [companyId], references: [id])
  file      File     @relation(fields: [fileId], references: [id])

  @@unique([companyId, fileId])
  @@index([deletedAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  companyId   String?
  actorUserId String?
  actorType   AuditActorType @default(USER)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  company     Company?       @relation(fields: [companyId], references: [id])
  actorUser   User?          @relation(fields: [actorUserId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([createdAt])
  @@index([deletedAt])
}
